{
  "manifest_version": 3,
  "name": "Claude Auto-Continue",
  "version": "2.4",
  "description": "Sends 'Continue' to Claude after a usage limit resets.",
  "permissions": [
    "alarms",
    "storage",
    "power",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Auto-Continue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}